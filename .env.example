# Copy to .env and fill in. Never commit .env.

# ─── Database ────────────────────────────────────────────────────────────────
# Local: `docker compose up -d db` gives you this URL.
# Production: the Neon connection string (pooled).
DATABASE_URL="postgresql://astral:astral@localhost:5432/astral"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Needed outside Vercel (local `next start`, CI). Vercel sets this automatically.
AUTH_TRUST_HOST="true"
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Redirect URI: <site URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend API key for magic-link sign-in emails (customers).
AUTH_RESEND_KEY=""
EMAIL_FROM="Astral Tech Gaming <no-reply@astralgaming.ca>"

# Comma-separated Google accounts allowed into /admin. They must sign in with Google.
ADMIN_EMAILS=""

# ─── Product images (Cloudflare R2) ──────────────────────────────────────────
# Leave R2_BUCKET empty locally: uploads are saved to .uploads/ instead.
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public bucket URL or custom domain, e.g. https://images.astralgaming.ca
R2_PUBLIC_URL=""

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Sentry (optional locally) ───────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed in CI/Vercel to upload source maps.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
